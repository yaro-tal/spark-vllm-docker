+
+    def _release_staged_pins(
+        self, req_id: str, keys: Collection[OffloadKey] | None = None
+    ) -> None:
+        """Drop the staging hold on `keys` (all of the request's pins when
+        None), so the rows become evictable again once nothing else reads them.
+
+        Called when a wave's load retires, when a wave re-stages (a wave holds
+        a complete staged set or nothing, so it never waits on new rows while
+        holding some), and when the request finalizes, so a request that never
+        loaded a staged wave cannot strand rows as non-evictable.
+
+        The expectation goes with the hold: once these keys are released no
+        wave expects them, so a later promotion of one (the non-streaming path
+        can promote any key it queries) is not held on a finished wave's behalf.
+        """
+        state = self._req_state.get(req_id)
+        if state is None:
+            return
+        if keys is None:
+            state.wave_expect.clear()
+        else:
+            state.wave_expect.difference_update(keys)
+        if not state.staged_pins:
+            return
+        pinned = (
+            state.staged_pins
+            if keys is None
+            else state.staged_pins.intersection(keys)
+        )
+        if not pinned:
+            return
+        self.primary_tier.complete_load(list(pinned), state.req_context)
+        state.staged_pins.difference_update(pinned)
+
+    def _hold_for_waiting_waves(self, keys: Collection[OffloadKey]) -> None:
+        """Hold each of `keys` that is now readable for every request whose
+        in-flight wave expects it.
+
+        Called whenever rows become readable: a promotion or a GPU store
+        completing. Expectations are per request, so holds are too. A key a
+        wave shares with another request's read or store must be held for this
+        wave as well, or it becomes evictable the moment the other request is
+        done with it. Each request takes and releases its own hold, so the
+        refcount stays balanced, and one hold per key per request (the
+        staged_pins check) because complete_load() releases exactly one.
+        Taking a hold here never waits: the rows are already resident.
+        """
+        for state in self._req_state.values():
+            wanted = [
+                k
+                for k in keys
+                if k in state.wave_expect
+                and k not in state.staged_pins
+                and self.primary_tier.lookup(k, state.req_context)
+                is LookupResult.HIT
+            ]
+            if not wanted:
+                continue
+            self.primary_tier.prepare_load(wanted, state.req_context)
+            state.staged_pins.update(wanted)
+            state.wave_expect.difference_update(wanted)
+
+    def release_wave_pins(self, req_context: ReqContext) -> None:
+        """Drop this request's staging holds because its wave is re-staging.
+
+        A wave that lost a key must re-read it, and rows are reserved for a
+        whole wave at once: holding the rest meanwhile would be hold-and-wait,
+        the one shape in which these holds could deadlock a full tier.
+        """
+        self._release_staged_pins(req_context.req_id)
 
